# Переменные ТОЛЬКО для docker compose (пути на хосте).
# Скопируйте в docker/.env и поправьте под себя.

# модели LLM
CMP_MODELS_DIR=/home/lyncher/models
# модель ASR
CMP_ASR_DIR=/home/lyncher/tone_asr
# TTS-модели (kokoro-ru-fp32 + silero)
CMP_TTS_MODELS=/home/lyncher/cmp-voice/models
# собранный форк llama.cpp (нужен libllama.so и т.д.)
CMP_LLAMA_BUILD=/home/lyncher/cmp-voice/src/llama-prism/build
# собранный демон
CMP_DAEMON=/home/lyncher/cmp-voice/daemon/bonsai_daemon
# конфиг сервиса (тот же, что /etc/cmp-voice.env)
CMP_ENV=/home/lyncher/cmp-voice/.env
# папка «Музыка» (Windows), монтируется в контейнер как /music
CMP_MUSIC_DIR=/mnt/c/Users/Administrator/Music
